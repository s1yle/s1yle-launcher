{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeCraft-Launcher",
  "version": "0.1.0",
  "identifier": "art.wecraft.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "create": false,
        "visible": false,
        "transparent": true,
        "focus": true,
        "focusable": true,
        "title": "WeCraft! Launcher - 登录",
        "label": "login",
        "width": 480,
        "height": 640,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false,
        "theme": "Dark",
        "minWidth": 480,
        "minHeight": 640,
        "center": true,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "zoomHotkeysEnabled": false,
        "backgroundThrottling": "disabled",
        "browserExtensionsEnabled": false,
        "scrollBarStyle": "fluentOverlay",
        "shadow": true,
        "skipTaskbar": false,
        "tabbingIdentifier": "tool",
        "windowClassname": "WeCraftLauncher"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "wecraft",
    "longDescription": "A modern, high-performance, open-source Minecraft launcher built with Tauri 2, React 19 and Rust.",
    "shortDescription": "Open-source Minecraft launcher",
    "homepage": "https://github.com/s1yle/s1yle-launcher",
    "category": "Game",
    "copyright": "Copyright © 2026 s1yle. Licensed under GPL-3.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
