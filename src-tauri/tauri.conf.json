{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeCraft-Launcher",
  "version": "0.1.0",
  "identifier": "art.wecraft.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": false
  },
  "app": {
    "windows": [
      {
        "create": false,
        "visible": false,
        "transparent": true,
        "focus": true,
        "focusable": true,
        "title": "WeCraft! Launcher",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false,
        "theme": "Dark",
        "center": true,
        "closable": true,
        "zoomHotkeysEnabled": false,
        "backgroundThrottling": "disabled",
        "browserExtensionsEnabled": false,
        "scrollBarStyle": "fluentOverlay",
        "shadow": true,
        "skipTaskbar": false,
        "tabbingIdentifier": "tool",
        "windowClassname": "WeCraftLauncher"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "wecraft",
    "longDescription": "A modern, high-performance, open-source Minecraft launcher built with Tauri 2, React 19 and Rust.",
    "shortDescription": "Open-source Minecraft launcher",
    "homepage": "https://github.com/s1yle/WeCraft-Launcher",
    "category": "Game",
    "copyright": "Copyright © 2026 s1yle. Licensed under GPL-3.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "wix": {
          "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {}
}
