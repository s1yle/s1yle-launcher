  <title>WeCraft! Launcher</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      border-radius: 100%;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      user-select: none;
      -webkit-user-select: none;
      position: relative;
    }

    .logo-wrap {
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      position: absolute;
      top: 0;
    }

    svg {
      width: 100%;
      height: auto;
      display: block;
    }

    @keyframes change {
      0% {
        opacity: 100%;
      }

      50% {
        opacity: 50%;
      }

      100% {
        opacity: 100%;
      }
    }

    /* ===== 应用动画的类，只给白色背景块使用 ===== */
    .white-bg {
      animation: change 2.5s ease-in-out infinite;
    }

    @keyframes change1 {
      0% {
        background-color: red;
      }

      50% {
        background-color: aqua;
      }

      100% {
        background-color: red;
      }
    }

    .else {
      animation: change1 2.5s ease-in-out infinite;
    }
  </style>
</head>

<body>
  <!-- <div class="drag" data-tauri-drag-region="true"></div> -->

  <div class="logo-wrap">
    <!--__WECRAFT_LOGO__-->
  </div>

</body>

